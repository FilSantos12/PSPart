# Nega todo acesso web a este diretório (credenciais). O PHP continua lendo os arquivos
# por require; só o acesso pela URL é bloqueado. Apache 2.4 (Require) e 2.2 (Deny).
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
